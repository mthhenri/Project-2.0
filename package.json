{
  "name": "project-2.0",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "desktop"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev --workspace=backend",
    "frontend:dev": "npm run start --workspace=frontend",
    "dev": "concurrently --kill-others-on-fail --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "predev": "npm run db:up && npm run db:migrate",
    "db:up": "node scripts/db-up.mjs",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:rollback": "npm run db:rollback --workspace=backend",
    "db:seed-dev": "npm run db:seed-dev --workspace=backend",
    "repo:verificar": "node scripts/verificar-organizacao.mjs",
    "repo:test": "node --test scripts/verificar-organizacao.test.mjs scripts/impacto.test.mjs scripts/formatar-sql.test.mjs scripts/eslint/regras.test.mjs",
    "impacto": "node scripts/impacto.mjs",
    "lint": "eslint .",
    "lint:estilos": "stylelint \"frontend/src/**/*.scss\"",
    "lint:templates": "prettier --check \"frontend/src/**/*.{html,scss}\"",
    "lint:sql": "node scripts/formatar-sql.mjs --check",
    "lint:tudo": "npm run lint && npm run lint:estilos && npm run lint:templates && npm run lint:sql",
    "formatar": "prettier --write \"frontend/src/**/*.{html,scss}\" && node scripts/formatar-sql.mjs",
    "test": "npm run test --workspace=shared && npm run test --workspace=backend && npm run test --workspace=frontend && npm run test --workspace=desktop && npm run repo:test",
    "test:integracao": "npm run test:integracao --workspace=backend",
    "test:cobertura": "node scripts/cobertura.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "angular-eslint": "^21.4.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sql-formatter": "^15.9.0",
    "stylelint": "^16.26.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
