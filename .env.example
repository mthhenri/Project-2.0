DB_HOST=localhost
DB_PORT=5433
DB_NOME=project20
DB_USUARIO=postgres
DB_SENHA=postgres
# Na homologação (Supabase) defina DB_SSL=true. Em dev local, deixe false ou omita.
DB_SSL=false
# Banco dos testes de integração (task 171). Omitido = <DB_NOME>_teste, criado e migrado por `npm run test:integracao`.
# Nunca aponte para o banco de desenvolvimento: o helper recusa.
# DB_NOME_TESTE=project20_teste

JWT_SECRETO=troque-em-producao-por-valor-seguro
JWT_EXPIRACAO=7d
# Opcional: dia e hora em que TODOS os tokens vencem, toda semana, no fuso de APP_TIMEZONE ("<DIA> <HH:MM>", DIA de DOMINGO a SABADO,
# sem acento). Com ela, JWT_EXPIRACAO não é usada no login; apague a linha para o token durar JWT_EXPIRACAO a partir do login.
JWT_CORTE_SEMANAL=SEGUNDA 06:00

INTERVALO_MINIMO_MINUTOS=15

# Opcional: sem a chave, o recurso de auxílio de descrições por IA fica indisponível
# (o resto do sistema funciona normalmente).
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Opcionais, para o fallback entre provedores (a ordem e os modelos são escolhidos em Configurações da IA).
# Sem a chave, o provedor é pulado na cadeia como se estivesse fora do ar.
# GOOGLE_API_KEY=coloque-a-chave-do-gemini-aqui
# OPENAI_API_KEY=sk-coloque-sua-chave-aqui

# Onde ficam as mensagens do chat: opensearch (desenvolvimento, padrão), postgres (tabelas PROVISÓRIAS, homologação)
# ou elasticsearch (produção).
# CHAT_ARMAZENAMENTO=opensearch
# Por onde os eventos do chat entre colaboradores (mensagem nova, "Lida", online) chegam a todas as instâncias da API: memoria
# (desenvolvimento, padrão; só uma instância) ou postgres (LISTEN/NOTIFY; obrigatório quando houver mais de uma instância).
# CHAT_EVENTOS=memoria
# OpenSearch: obrigatório só com CHAT_ARMAZENAMENTO=opensearch. Usuário e senha só se o servidor tiver segurança ligada.
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USUARIO=
# OPENSEARCH_SENHA=
# Elasticsearch: ELASTICSEARCH_URL é obrigatória só com CHAT_ARMAZENAMENTO=elasticsearch. Autenticação: chave de API (Elastic Cloud)
# ou usuário e senha; sem nenhuma, conecta sem autenticar (só para o servidor de teste local: docker compose --profile elasticsearch up -d elasticsearch).
# ELASTICSEARCH_URL=http://localhost:9201
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_USUARIO=
# ELASTICSEARCH_SENHA=

# Porta local. Na homologação, o Render injeta PORT, que tem prioridade.
APP_PORTA=3000
APP_AMBIENTE=development

# Opcional: quantos proxies à frente da API têm o X-Forwarded-For aceito (a produção em containers usa 1). Sem ela vale o IP da conexão.
# APP_PROXIES_CONFIAVEIS=1

# Fuso horário da aplicação. As colunas de data/hora são timestamptz (instante UTC no
# banco); a sessão do banco é fixada neste fuso (via afterCreate do pool e do knexfile)
# para que NOW() e o bucketing por dia (DATE/::date) extraiam o dia local correto.
# Default: America/Sao_Paulo.
APP_TIMEZONE=America/Sao_Paulo
# Timezone do processo Node. Mantida por conveniência (logs/exibição local); a correção
# de fuso do banco não depende mais dela, e sim de APP_TIMEZONE + colunas timestamptz.
TZ=America/Sao_Paulo
# Origem permitida no CORS (URL do frontend). Na homologação: https://seu-front.pages.dev
# Vazio/omitido = libera qualquer origem (use só em dev).
APP_CORS_ORIGEM=

# Opcional: pasta do servidor com o executável do Project Desktop (`Project-Desktop-<versão>.exe`, gerado por `npm run pack --workspace=desktop`).
# O backend serve o de maior versão em GET /desktop/download e o botão "Baixar Project Desktop" aparece. Sem ela, não há download.
# DESKTOP_PASTA_EXECUTAVEIS=/srv/project-desktop
