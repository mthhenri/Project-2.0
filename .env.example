DB_HOST=localhost
DB_PORT=5432
DB_NOME=project20
DB_USUARIO=postgres
DB_SENHA=postgres
# Em produção (Supabase) defina DB_SSL=true. Em dev local, deixe false ou omita.
DB_SSL=false

JWT_SECRETO=troque-em-producao-por-valor-seguro
JWT_EXPIRACAO=8h

INTERVALO_MINIMO_MINUTOS=15

# Opcional: sem a chave, o recurso de auxílio de descrições por IA fica indisponível
# (o resto do sistema funciona normalmente).
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui
ANTHROPIC_MODELO=claude-sonnet-4-6
ANTHROPIC_MAXIMO_TOKENS=1024

# Porta local. Em produção, a plataforma (ex.: Render) injeta PORT, que tem prioridade.
APP_PORTA=3000
APP_AMBIENTE=development

# Fuso horário da aplicação. As colunas de data/hora são timestamptz (instante UTC no
# banco); a sessão do banco é fixada neste fuso (via afterCreate do pool e do knexfile)
# para que NOW() e o bucketing por dia (DATE/::date) extraiam o dia local correto.
# Default: America/Sao_Paulo.
APP_TIMEZONE=America/Sao_Paulo
# Timezone do processo Node. Mantida por conveniência (logs/exibição local); a correção
# de fuso do banco não depende mais dela, e sim de APP_TIMEZONE + colunas timestamptz.
TZ=America/Sao_Paulo
# Origem permitida no CORS (URL do frontend). Em produção: https://seu-front.pages.dev
# Vazio/omitido = libera qualquer origem (use só em dev).
APP_CORS_ORIGEM=
