# API de produção. Roda do TypeScript com ts-node, como na homologação (o pacote shared é consumido como fonte).
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
RUN npm ci --workspace=backend --workspace=shared
COPY shared shared
COPY backend backend
WORKDIR /app/backend
USER node
CMD ["node", "--require", "ts-node/register/transpile-only", "src/main.ts"]
