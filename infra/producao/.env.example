# Configuração da PRODUÇÃO em containers. `npm run prod:up` cria o infra/producao/.env a partir deste modelo (uma vez, sem
# sobrescrever) e gera DB_SENHA e JWT_SECRETO. O .env fica fora do Git: guarde uma cópia em lugar seguro.
# O que é fixo da produção (endereços dos containers, CORS, proxy) está no compose.yml.

DB_NOME=project20
DB_USUARIO=postgres
# A senha vale na criação do banco. Para trocar depois, altere também no PostgreSQL (veja o README).
DB_SENHA=

JWT_SECRETO=
JWT_EXPIRACAO=7d
JWT_CORTE_SEMANAL=SEGUNDA 06:00

INTERVALO_MINIMO_MINUTOS=15
APP_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Chaves de IA da produção (opcionais; sem nenhuma, só os recursos de IA ficam indisponíveis).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
