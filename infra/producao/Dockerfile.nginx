# O front compilado para a API na mesma origem, servido pelo Nginx.
FROM node:22-bookworm-slim AS construcao
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY frontend/package.json frontend/
RUN npm ci --workspace=frontend --workspace=shared
COPY shared shared
COPY frontend frontend
WORKDIR /app/frontend
RUN npx ng build --configuration production,container

FROM nginx:1.28-alpine
COPY infra/producao/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=construcao /app/frontend/dist/frontend/browser /usr/share/nginx/html
